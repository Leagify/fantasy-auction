{
    "name": ".NET Development",
    "image": "mcr.microsoft.com/devcontainers/dotnet:8.0", // Use stable .NET 8 image
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-vscode.vscode-node-azure-pack"
            ]
        }
    },
    "forwardPorts": [7000, 7001, 7002, 5000, 5001, 5002],
    "postCreateCommand": "dotnet build FantasyAuctionWASM.sln",
    "portsAttributes": {
        "5001": {
            "label": "App HTTPS",
            "onAutoForward": "openBrowser"
        },
        "7071": {
            "label": "App HTTPS",
            "onAutoForward": "openPreview"
        }
    },
    "remoteUser": "vscode"
}
