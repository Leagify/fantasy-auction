@inherits LayoutComponentBase

@* TODO: Review if any specific WASM layout considerations are needed.
   The NavMenu will be from the old project.
   The error UI might be different or handled by index.html in WASM. *@

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* Consider what links or info should be here for the WASM app *@
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About Blazor</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@* Default Blazor WASM templates often put error UI handling in index.html
   or provide a specific error component. For now, this is copied from server-side.
   It might need to be removed or adapted if index.html has its own. *@
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
