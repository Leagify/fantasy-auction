@* FantasyAuctionWASM.Client/Layout/NavMenu.razor *@
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FantasyAuctionWASM</a> @* Updated App Name *@
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="auction-status">
                <span class="bi bi-bar-chart-line-fill-nav-menu" aria-hidden="true"></span> Auction Status
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="available-players">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Available Players
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bidder-roster">
                <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> My Roster
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bidding-controls">
                <span class="bi bi-hammer-nav-menu" aria-hidden="true"></span> Bidding
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="download-results">
                <span class="bi bi-download-nav-menu" aria-hidden="true"></span> Download Results
            </NavLink>
        </div>
    </nav>
</div>
